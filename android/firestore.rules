rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: /users/{userId}
// Document ID: {userId} (matches request.auth.uid)
// Fields: Direct writes disallowed; owner read only.
//
// Collection: /users/{userId}/medicalProfile
// Document ID: 'current'
// Fields:
//   - conditions: list of strings (required, max 100 items)
//   - allergies: list of strings (required, max 100 items)
//   - medications: list of strings (required, max 100 items)
//   - dietaryRestrictions: list of strings (required, max 100 items)
//   - healthNotes: list of strings (required, max 100 items)
//   - updatedAt: timestamp (required)
//
// Collection: /users/{userId}/medicalReports
// Document ID: autoId
// Fields:
//   - reportTitle: string (required, max 200 chars)
//   - reportType: string (required, max 100 chars)
//   - markersCount: int (required, >= 0, <= 500)
//   - identifiersMasked: int (required, >= 0)
//   - maskedOnDevice: bool (required, must be true)
//   - pagesScanned: int (required, >= 0, <= 50)
//   - truncated: bool (required)
//   - aiEngine: string (required, max 50 chars)
//   - savedAt: timestamp (required)
//
// Collection: /users/{userId}/scanHistory
// Document ID: autoId
// Fields:
//   - kind: string (required, 'ingredient' or 'medical_report')
//   - title: string (required, max 200 chars)
//   - subtitle: string (required, max 200 chars)
//   - reportId: string (optional, max 100 chars)
//   - safetyScore: int (optional, >= 0, <= 100)
//   - badgeLabel: string (optional, max 50 chars)
//   - headline: string (optional, max 200 chars)
//   - ingredientCount: int (optional, >= 0, <= 500)
//   - aiEngine: string (required, max 50 chars)
//   - scannedAt: timestamp (required)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------
    // Helper Functions
    // ---------------------------------------------------------------

    // Check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the user owns the path
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Validate that document contains only the allowed fields
    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // Validate that required fields exist in document
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // ---------------------------------------------------------------
    // Domain Validators
    // ---------------------------------------------------------------

    // Domain Validator: /users/{userId}/medicalProfile/current
    function isValidMedicalProfile(data) {
      return data.keys().hasOnly(['conditions', 'allergies', 'medications', 'dietaryRestrictions', 'healthNotes', 'updatedAt']) &&
             data.keys().hasAll(['conditions', 'allergies', 'medications', 'dietaryRestrictions', 'healthNotes', 'updatedAt']) &&
             data.conditions is list && data.conditions.size() <= 100 &&
             data.allergies is list && data.allergies.size() <= 100 &&
             data.medications is list && data.medications.size() <= 100 &&
             data.dietaryRestrictions is list && data.dietaryRestrictions.size() <= 100 &&
             data.healthNotes is list && data.healthNotes.size() <= 100 &&
             data.updatedAt is timestamp;
    }

    // Domain Validator: /users/{userId}/medicalReports/{reportId}
    function isValidMedicalReport(data) {
      return data.keys().hasOnly(['reportTitle', 'reportType', 'markersCount', 'identifiersMasked', 'maskedOnDevice', 'pagesScanned', 'truncated', 'aiEngine', 'savedAt']) &&
             data.keys().hasAll(['reportTitle', 'reportType', 'markersCount', 'identifiersMasked', 'maskedOnDevice', 'pagesScanned', 'truncated', 'aiEngine', 'savedAt']) &&
             data.reportTitle is string && data.reportTitle.size() <= 200 &&
             data.reportType is string && data.reportType.size() <= 100 &&
             data.markersCount is int && data.markersCount >= 0 && data.markersCount <= 500 &&
             data.identifiersMasked is int && data.identifiersMasked >= 0 &&
             data.maskedOnDevice is bool && data.maskedOnDevice == true &&
             data.pagesScanned is int && data.pagesScanned >= 0 && data.pagesScanned <= 50 &&
             data.truncated is bool &&
             data.aiEngine is string && data.aiEngine.size() <= 50 &&
             data.savedAt is timestamp;
    }

    // Domain Validator: /users/{userId}/scanHistory/{scanId}
    function isValidScanHistory(data) {
      return data.keys().hasOnly(['kind', 'title', 'subtitle', 'reportId', 'safetyScore', 'badgeLabel', 'headline', 'ingredientCount', 'aiEngine', 'scannedAt']) &&
             data.keys().hasAll(['kind', 'title', 'subtitle', 'aiEngine', 'scannedAt']) &&
             data.kind is string && (data.kind == 'ingredient' || data.kind == 'medical_report') &&
             data.title is string && data.title.size() <= 200 &&
             data.subtitle is string && data.subtitle.size() <= 200 &&
             data.aiEngine is string && data.aiEngine.size() <= 50 &&
             data.scannedAt is timestamp &&
             (!('reportId' in data) || (data.reportId is string && data.reportId.size() <= 100)) &&
             (!('safetyScore' in data) || (data.safetyScore is int && data.safetyScore >= 0 && data.safetyScore <= 100)) &&
             (!('badgeLabel' in data) || (data.badgeLabel is string && data.badgeLabel.size() <= 50)) &&
             (!('headline' in data) || (data.headline is string && data.headline.size() <= 200)) &&
             (!('ingredientCount' in data) || (data.ingredientCount is int && data.ingredientCount >= 0 && data.ingredientCount <= 500));
    }

    // ---------------------------------------------------------------
    // Match Rules
    // ---------------------------------------------------------------

    match /users/{userId} {
      // Root user doc: owner can read; direct writes are disallowed
      allow read: if isOwner(userId);
      allow write: if false;

      // Medical Profile: restricted to document 'current'
      match /medicalProfile/{profileId} {
        allow read, delete: if isOwner(userId) && profileId == 'current';
        allow create, update: if isOwner(userId) && profileId == 'current' && isValidMedicalProfile(request.resource.data);
      }

      // Medical Reports: append-only audit records (no updates allowed)
      match /medicalReports/{reportId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidMedicalReport(request.resource.data);
        allow update: if false;
      }

      // Scan History: append-only audit records (no updates allowed)
      match /scanHistory/{scanId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidScanHistory(request.resource.data);
        allow update: if false;
      }

      // Explicit deny for any other subcollections under a user
      match /{document=**} {
        allow read, write: if false;
      }
    }

    // Default deny for all documents outside /users
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

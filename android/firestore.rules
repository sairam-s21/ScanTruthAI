rules_version = '2';

// ===============================================================
// Shared data model (SPEC.md section 2) for the iOS, Android and web apps
// ===============================================================
//
// /users/{userId}                       direct writes disallowed; owner read only
//
// /users/{userId}/medicalProfile/current
//   updatedAt (timestamp, required)
//   conditions, allergies, medications, dietaryRestrictions, healthNotes
//                                       (lists of strings, optional, max 100 each)
//   healthMarkers (list, optional, max 500), markersCount (int), reportTitle (string)
//   Partial documents are allowed because web and iOS merge with arrayUnion.
//
// /users/{userId}/medicalReports/{id}   append-only
//   reportTitle, markersCount, maskedOnDevice == true (required)
//   uploadedAt or savedAt (timestamp, at least one)
//   reportType, identifiersMasked, pagesScanned, truncated, aiEngine (optional)
//   Report text (raw or redacted) is never stored.
//
// /users/{userId}/healthNotes/{id}      append-only
//   userNote, extractedSummary, createdAt (all required)
//
// /users/{userId}/scanHistory/{id}      append-only
//   scannedAt (timestamp, required) and productName (or legacy title)
//   productCategory, safetyScore (0-100), badgeLabel, headline, aiSummary,
//   healthFactors, ingredientBreakdown, recommendedIntake, rawIngredients, modelUsed
//   Legacy fields from Android builds before the shared schema:
//   kind, title, subtitle, reportId, ingredientCount, aiEngine
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------
    // Helper Functions
    // ---------------------------------------------------------------

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function optString(data, field, maxLength) {
      return !(field in data) || (data[field] is string && data[field].size() <= maxLength);
    }

    function optList(data, field, maxItems) {
      return !(field in data) || (data[field] is list && data[field].size() <= maxItems);
    }

    function optInt(data, field, minValue, maxValue) {
      return !(field in data) ||
             (data[field] is int && data[field] >= minValue && data[field] <= maxValue);
    }

    function optBool(data, field) {
      return !(field in data) || data[field] is bool;
    }

    function optTimestamp(data, field) {
      return !(field in data) || data[field] is timestamp;
    }

    // ---------------------------------------------------------------
    // Domain Validators
    // ---------------------------------------------------------------

    // Domain Validator: /users/{userId}/medicalProfile/current
    function isValidMedicalProfile(data) {
      return data.keys().hasOnly(['conditions', 'allergies', 'medications', 'dietaryRestrictions',
                                  'healthNotes', 'healthMarkers', 'markersCount', 'reportTitle',
                                  'updatedAt']) &&
             data.keys().hasAll(['updatedAt']) &&
             data.updatedAt is timestamp &&
             optList(data, 'conditions', 100) &&
             optList(data, 'allergies', 100) &&
             optList(data, 'medications', 100) &&
             optList(data, 'dietaryRestrictions', 100) &&
             optList(data, 'healthNotes', 100) &&
             optList(data, 'healthMarkers', 500) &&
             optInt(data, 'markersCount', 0, 500) &&
             optString(data, 'reportTitle', 200);
    }

    // Domain Validator: /users/{userId}/medicalReports/{reportId}
    function isValidMedicalReport(data) {
      return data.keys().hasOnly(['reportTitle', 'reportType', 'markersCount', 'identifiersMasked',
                                  'maskedOnDevice', 'pagesScanned', 'truncated', 'aiEngine',
                                  'uploadedAt', 'savedAt']) &&
             data.keys().hasAll(['reportTitle', 'markersCount', 'maskedOnDevice']) &&
             data.reportTitle is string && data.reportTitle.size() <= 200 &&
             data.markersCount is int && data.markersCount >= 0 && data.markersCount <= 500 &&
             data.maskedOnDevice is bool && data.maskedOnDevice == true &&
             ('uploadedAt' in data || 'savedAt' in data) &&
             optTimestamp(data, 'uploadedAt') &&
             optTimestamp(data, 'savedAt') &&
             optString(data, 'reportType', 100) &&
             optInt(data, 'identifiersMasked', 0, 10000) &&
             optInt(data, 'pagesScanned', 0, 50) &&
             optBool(data, 'truncated') &&
             optString(data, 'aiEngine', 50);
    }

    // Domain Validator: /users/{userId}/healthNotes/{noteId}
    function isValidHealthNote(data) {
      return data.keys().hasOnly(['userNote', 'extractedSummary', 'createdAt']) &&
             data.keys().hasAll(['userNote', 'extractedSummary', 'createdAt']) &&
             data.userNote is string && data.userNote.size() <= 5000 &&
             data.extractedSummary is string && data.extractedSummary.size() <= 1000 &&
             data.createdAt is timestamp;
    }

    // Domain Validator: /users/{userId}/scanHistory/{scanId}
    function isValidScanHistory(data) {
      return data.keys().hasOnly(['productName', 'productCategory', 'safetyScore', 'badgeLabel',
                                  'headline', 'aiSummary', 'healthFactors', 'ingredientBreakdown',
                                  'recommendedIntake', 'rawIngredients', 'modelUsed', 'scannedAt',
                                  'kind', 'title', 'subtitle', 'reportId', 'ingredientCount',
                                  'aiEngine']) &&
             data.keys().hasAll(['scannedAt']) &&
             data.scannedAt is timestamp &&
             ('productName' in data || 'title' in data) &&
             optString(data, 'productName', 200) &&
             optString(data, 'productCategory', 50) &&
             optInt(data, 'safetyScore', 0, 100) &&
             optString(data, 'badgeLabel', 50) &&
             optString(data, 'headline', 500) &&
             optString(data, 'aiSummary', 4000) &&
             optList(data, 'healthFactors', 40) &&
             optList(data, 'ingredientBreakdown', 100) &&
             optList(data, 'rawIngredients', 500) &&
             (!('recommendedIntake' in data) || data.recommendedIntake is map) &&
             optString(data, 'modelUsed', 100) &&
             (!('kind' in data) || data.kind in ['ingredient', 'medical_report']) &&
             optString(data, 'title', 200) &&
             optString(data, 'subtitle', 200) &&
             optString(data, 'reportId', 100) &&
             optInt(data, 'ingredientCount', 0, 500) &&
             optString(data, 'aiEngine', 50);
    }

    // ---------------------------------------------------------------
    // Match Rules
    // ---------------------------------------------------------------

    match /users/{userId} {
      // Root user doc: owner can read; direct writes are disallowed
      allow read: if isOwner(userId);
      allow write: if false;

      // Medical Profile: restricted to document 'current'
      match /medicalProfile/{profileId} {
        allow read, delete: if isOwner(userId) && profileId == 'current';
        allow create, update: if isOwner(userId) && profileId == 'current' && isValidMedicalProfile(request.resource.data);
      }

      // Medical Reports: append-only audit records (no updates allowed)
      match /medicalReports/{reportId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidMedicalReport(request.resource.data);
        allow update: if false;
      }

      // Typed health notes: append-only (no updates allowed)
      match /healthNotes/{noteId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidHealthNote(request.resource.data);
        allow update: if false;
      }

      // Scan History: append-only audit records (no updates allowed)
      match /scanHistory/{scanId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidScanHistory(request.resource.data);
        allow update: if false;
      }

      // Explicit deny for any other subcollections under a user
      match /{document=**} {
        allow read, write: if false;
      }
    }

    // Default deny for all documents outside /users
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

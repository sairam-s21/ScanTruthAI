# ScanTruthAI Release Signing Properties Template
# DO NOT COMMIT THE ACTUAL keystore.properties FILE (protected by .gitignore)
#
# Values:
# storeFile: path to upload-keystore.jks relative to android/ (e.g. upload-keystore.jks)
# storePassword: your secure keystore password
# keyAlias: the key alias (e.g. upload)
# keyPassword: your secure key password

storeFile=upload-keystore.jks
storePassword=CHANGE_ME_SECURE_STORE_PASSWORD
keyAlias=upload
keyPassword=CHANGE_ME_SECURE_KEY_PASSWORD
